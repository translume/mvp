# Docker Compose reads the repository-root .env file.
# Enter your real OpenAI project key there; never commit it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_MODEL=gpt-6-astra
OPENAI_NORMALIZER_MODEL=gpt-6-astra
OPENAI_REASONING_MODE=pro
OPENAI_REASONING_EFFORT=xhigh
OPENAI_REQUEST_TIMEOUT_SECONDS=900
DYNAMIC_PATHWAY_RUN_TIMEOUT_SECONDS=7200
MAX_JSON_CHARS=180000
MAX_FINDINGS=80
MAX_SOURCE_RECORDS=40
MAX_RESEARCH_PATHWAYS=5
